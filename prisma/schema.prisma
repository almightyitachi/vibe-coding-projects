// SprintDesk — Prisma schema
// PostgreSQL data model for the design operating system.
// Generated for: Users, Teams, Projects, Features, Modules, Sprints, Tasks,
// Comments, Attachments, Documents, Reviews, Notifications, Activity Logs,
// Permissions, Tags and their relationships.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  DESIGN_LEAD
  DESIGNER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  REVIEW
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  APPROVED
  DONE
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum DesignStage {
  DISCOVERY
  WIREFRAME
  VISUAL
  PROTOTYPE
  HANDOFF
}

enum ReviewStatus {
  DRAFT
  READY
  CHANGES_REQUESTED
  APPROVED
  CLOSED
}

enum NotificationKind {
  ASSIGNMENT
  MENTION
  STATUS_CHANGE
  SPRINT_EVENT
  REVIEW_REQUEST
  COMMENT
}

enum ActivityVerb {
  CREATED
  UPDATED
  MOVED
  COMMENTED
  ASSIGNED
  APPROVED
  REQUESTED_CHANGES
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// Workspace & identity
// ─────────────────────────────────────────────────────────────
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    Membership[]
  teams      Team[]
  projects   Project[]
  documents  Document[]
  tags       Tag[]
  templates  Template[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  title     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  teamMembers   TeamMember[]
  ownedProjects Project[]        @relation("ProjectOwner")
  ownedSprints  Sprint[]         @relation("SprintOwner")
  assignedTasks Task[]           @relation("TaskAssignee")
  reportedTasks Task[]           @relation("TaskReporter")
  comments      Comment[]
  documents     Document[]       @relation("DocAuthor")
  authoredReviews Review[]       @relation("ReviewAuthor")
  reviewAssignments ReviewAssignment[]
  notifications Notification[]   @relation("NotificationRecipient")
  activities    ActivityLog[]    @relation("ActivityActor")
  attachments   Attachment[]     @relation("AttachmentUploader")
}

// Workspace membership carries the workspace-level role (permissions model).
model Membership {
  id          String   @id @default(cuid())
  role        Role     @default(DESIGNER)
  createdAt   DateTime @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  projects    Project[]

  @@index([workspaceId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// ─────────────────────────────────────────────────────────────
// Delivery hierarchy: Project → Module / Feature → Sprint → Task
// ─────────────────────────────────────────────────────────────
model Project {
  id          String        @id @default(cuid())
  key         String // e.g. "MOB" — used for task ids MOB-142
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id])

  modules    Module[]
  features   Feature[]
  sprints    Sprint[]
  tasks      Task[]
  documents  Document[]
  reviews    Review[]
  milestones Milestone[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model Module {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features  Feature[]
  tasks     Task[]
  documents Document[]

  @@index([projectId])
}

model Feature {
  id              String   @id @default(cuid())
  name            String
  overview        String?
  problemStatement String?
  goals           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    Module? @relation(fields: [moduleId], references: [id])
  tasks     Task[]
  documents Document[]

  @@index([projectId])
}

model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  status    SprintStatus @default(PLANNING)
  startDate DateTime?
  endDate   DateTime?
  velocity  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User    @relation("SprintOwner", fields: [ownerId], references: [id])
  tasks     Task[]

  @@index([projectId, status])
}

model Task {
  id           String      @id @default(cuid())
  number       Int // sequential per project → renders as KEY-number
  title        String
  description  String?
  status       TaskStatus  @default(BACKLOG)
  priority     Priority    @default(MEDIUM)
  points       Int         @default(0)
  designStage  DesignStage?
  figmaUrl     String?
  prototypeUrl String?
  designVersion String?
  dueDate      DateTime?
  boardRank    String? // fractional index for drag-ordering within a column
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId   String?
  sprint     Sprint? @relation(fields: [sprintId], references: [id])
  moduleId   String?
  module     Module? @relation(fields: [moduleId], references: [id])
  featureId  String?
  feature    Feature? @relation(fields: [featureId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporterId String
  reporter   User    @relation("TaskReporter", fields: [reporterId], references: [id])

  comments    Comment[]
  attachments Attachment[]
  tags        TaskTag[]
  reviews     Review[]

  @@unique([projectId, number])
  @@index([sprintId, status])
  @@index([assigneeId, status])
}

model Milestone {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Documentation (lightweight Confluence)
// ─────────────────────────────────────────────────────────────
model Document {
  id        String   @id @default(cuid())
  title     String
  icon      String   @default("📄")
  body      Json // rich-text document as portable JSON (ProseMirror/Tiptap)
  excerpt   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("DocAuthor", fields: [authorId], references: [id])

  // A document can hang off any node in the hierarchy or be a child page.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id])
  featureId String?
  feature   Feature? @relation(fields: [featureId], references: [id])
  parentId  String?
  parent    Document?  @relation("DocTree", fields: [parentId], references: [id])
  children  Document[] @relation("DocTree")

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  versions    DocumentVersion[]
  attachments Attachment[]

  @@index([workspaceId])
  @@index([projectId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  version    Int
  body       Json
  createdAt  DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model Template {
  id          String   @id @default(cuid())
  name        String // Research, Design Brief, Feature Spec, Retrospective...
  body        Json
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   Document[]
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────
model Review {
  id        String       @id @default(cuid())
  title     String
  status    ReviewStatus @default(DRAFT)
  figmaUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id])

  reviewers ReviewAssignment[]
  threads   ReviewThread[]

  @@index([projectId, status])
}

model ReviewAssignment {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  approved Boolean @default(false)

  @@unique([reviewId, userId])
}

model ReviewThread {
  id        String   @id @default(cuid())
  body      String
  resolved  Boolean  @default(false)
  x         Float? // pin coordinates on the design preview
  y         Float?
  createdAt DateTime @default(now())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([reviewId, resolved])
}

// ─────────────────────────────────────────────────────────────
// Collaboration primitives
// ─────────────────────────────────────────────────────────────
model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  taskId   String?
  task     Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  threadId String?
  thread   ReviewThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String // S3 object key
  createdAt  DateTime @default(now())

  uploaderId String
  uploader   User   @relation("AttachmentUploader", fields: [uploaderId], references: [id])
  taskId     String?
  task       Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([documentId])
}

model Tag {
  id          String @id @default(cuid())
  label       String
  color       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskTag[]

  @@unique([workspaceId, label])
}

model TaskTag {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ─────────────────────────────────────────────────────────────
// Notifications & audit
// ─────────────────────────────────────────────────────────────
model Notification {
  id          String           @id @default(cuid())
  kind        NotificationKind
  text        String
  href        String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
}

model ActivityLog {
  id         String       @id @default(cuid())
  verb       ActivityVerb
  entityType String // "Task" | "Sprint" | "Document" | "Review"
  entityId   String
  metadata   Json?
  createdAt  DateTime     @default(now())

  actorId String
  actor   User   @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
